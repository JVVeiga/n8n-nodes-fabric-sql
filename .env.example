# Only needed for manual verification against a real Fabric tenant.
# The test suite (`npm test`) requires none of these.
#
# Copy to .env (gitignored) before running any manual check.

# Lakehouse > Settings > SQL connection string (host only, no port, no ODBC string)
FABRIC_SERVER=xxxxxxxx.datawarehouse.fabric.microsoft.com
FABRIC_DATABASE=my_lakehouse

# App registration (service principal)
FABRIC_TENANT_ID=00000000-0000-0000-0000-000000000000
FABRIC_CLIENT_ID=00000000-0000-0000-0000-000000000000
FABRIC_CLIENT_SECRET=
